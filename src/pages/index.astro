---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import CurrentMission from '../components/CurrentMission.astro';
import CardsRow from '../components/CardsRow.astro';
import ImproveEnglish from '../components/ImproveEnglish.astro';
import CrmRoadmapPanel from '../components/CrmRoadmapPanel.astro';
import TailwindRoadmapPanel from '../components/TailwindRoadmapPanel.astro';
import FooterStats from '../components/FooterStats.astro';
import AccentMasteryPanel from '../components/AccentMasteryPanel.astro';
---

<BaseLayout>
    <!-- Main container: 2322x1252, centered on the 3440x1440 canvas -->
    <main class="flex h-[1252px] w-[2322px] gap-[20px] bg-[#000A1C] text-slate-300">
        <!-- ============ Left + center group ============ -->
        <div class="flex flex-col gap-[20px]">
            <div class="flex gap-[20px]">
                <!-- Left column -->
                <div class="flex flex-col gap-[20px]">
                    <!-- PANEL 1: MY CRM (1444x755) -->
                    <section
                        class="w-[1444px] flex-none rounded-lg border border-[#868D9D] pt-[10px] pr-[10px] pb-[30px] pl-[40px]">
                        <Header />
                        <CurrentMission />
                        <CardsRow />
                    </section>

                    <!-- Bottom row: English + CRM Roadmap (357 tall) -->
                    <div class="flex gap-[20px]">
                        <ImproveEnglish />
                        <CrmRoadmapPanel />
                    </div>
                </div>

                <!-- PANEL 2: TAILWIND COURSE ROADMAP (456x1132) -->
                <TailwindRoadmapPanel />
            </div>

            <!-- FOOTER stats bar -->
            <FooterStats />
        </div>

        <!-- PANEL 3: AMERICAN ACCENT MASTERY (382 x full height) -->
        <AccentMasteryPanel />
    </main>
</BaseLayout>

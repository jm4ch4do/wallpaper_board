---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import CurrentMission from "../components/CurrentMission.astro";
import CardsRow from "../components/CardsRow.astro";
import TailwindRoadmapPanel from "../components/TailwindRoadmapPanel.astro";
import FooterStats from "../components/FooterStats.astro";
import LongList2Panel from "../components/LongList2Panel.astro";
import { projectCards, extraCards } from "../data/projectCards";
import { accentSteps } from "../data/longList2Steps";
---

<BaseLayout>
    <!-- Outer frame: sits between the page background and the panels -->
    <div class="rounded-xl bg-[#000A1C]/60 p-[40px]">
        <!-- Main container: 2322x996, sized to its panels -->
        <main
            class="flex h-[996px] w-[2322px] gap-[20px] bg-[#000A1C]/60 text-slate-300"
        >
            <!-- ============ Left + center group ============ -->
            <div class="flex flex-col gap-[20px]">
                <div class="flex gap-[20px]">
                    <!-- PANEL 1: MY CRM -->
                    <section
                        class="w-[1444px] flex-none rounded-lg border border-[#868D9D] bg-[#000A1C] pt-[10px] pr-[10px] pb-[30px] pl-[40px]"
                    >
                        <Header />
                        <CurrentMission />
                        <CardsRow items={projectCards} />
                        <CardsRow items={extraCards} />
                    </section>

                    <!-- PANEL 2: TAILWIND COURSE ROADMAP -->
                    <TailwindRoadmapPanel />
                </div>

                <!-- FOOTER stats bar -->
                <FooterStats />
            </div>

            <!-- PANEL 3: AMERICAN ACCENT MASTERY (382 x full height) -->
            <LongList2Panel
                title="AMERICAN ACCENT MASTERY"
                items={accentSteps}
                footerText="Sections 12-15 to follow ..."
            />
        </main>
    </div>
</BaseLayout>

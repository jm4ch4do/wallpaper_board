---
import type { Lecture } from '../data/lectures';

interface Props {
    lectures: Lecture[];
}

const { lectures } = Astro.props;
const completed = lectures.filter((lecture) => lecture.active).length;
const total = lectures.length;
const radius = 70;
const circumference = 2 * Math.PI * radius;
const filledLength = (completed / total) * circumference;
---

<div class="ml-[-22px] mr-8 flex flex-none items-center justify-center">
    <div class="relative">
        <svg viewBox="0 0 160 160" class="size-40">
            <circle cx="80" cy="80" r={radius} fill="none" stroke="#0E2A45" stroke-width="12" />
            <circle
                cx="80"
                cy="80"
                r={radius}
                fill="none"
                stroke="#22d3ee"
                stroke-width="12"
                stroke-linecap="round"
                stroke-dasharray={`${filledLength} ${circumference - filledLength}`}
                transform="rotate(-90 80 80)"
                data-progress-ring
                data-progress-circumference={circumference}
            />
        </svg>
        <div class="absolute inset-0 flex flex-col items-center justify-center">
            <p class="text-2xl font-bold text-white" data-lecture-count>{completed} / {total}</p>
            <p class="text-[10px] tracking-[0.25em] text-cyan-400">LECTURES</p>
        </div>
    </div>
</div>

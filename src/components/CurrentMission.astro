---
import LectureColumn from './LectureColumn.astro';
import ProgressRing from './ProgressRing.astro';
import { lectures, lectureColumns } from '../data/lectures';
---

<div class="mt-5 mr-[20px] rounded-xl border border-slate-500/70 p-4 pt-3 pb-3">
    <div class="flex items-stretch gap-8 py-1">
        <div class="flex min-w-0 flex-1 items-center gap-8">
            <svg viewBox="0 0 100 100" class="size-20 flex-none">
                <polygon points="50,4 93,27 93,73 50,96 7,73 7,27" fill="none" stroke="#22d3ee" stroke-width="3" />
                <text x="50" y="66" text-anchor="middle" font-size="42" font-weight="700" fill="#22d3ee">T</text>
            </svg>
            <div class="min-w-0 flex-1">
                <p class="section-title tracking-[0.08em]">CURRENT MISSION</p>
                <h2 class="mt-0.5 text-3xl leading-tight font-extrabold text-white">TAILWIND CSS FROM SCRATCH</h2>
                <p class="mt-1.5 text-sm font-semibold tracking-widest text-cyan-400">
                    11 LECTURES <span class="text-slate-600">·</span> ~12h 30m
                </p>
                <p class="mt-2 text-sm text-slate-400">Learn the core utility classes that power every Tailwind
                    project.</p>
            </div>
        </div>

        <LectureColumn items={lectureColumns[0]} widthClass="w-[260px]" textClass="text-slate-200" />
        <LectureColumn items={lectureColumns[1]} widthClass="w-[320px]" offsetClass="-ml-4" textClass="text-slate-400" />

        <ProgressRing lectures={lectures} />
    </div>
</div>

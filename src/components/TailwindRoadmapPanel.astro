---
import RoadmapStepItem from "./RoadmapStepItem.astro";
import { roadmapSteps } from "../data/roadmapSteps";
---

<aside
    class="flex w-[456px] flex-none flex-col rounded-lg border border-[#868D9D] p-5"
>
    <p class="section-title tracking-[0.04em]">TAILWIND COURSE ROADMAP</p>
    <div class="mt-4 flex flex-1 flex-col justify-between">
        {roadmapSteps.map((step) => <RoadmapStepItem {...step} />)}
    </div>
</aside>

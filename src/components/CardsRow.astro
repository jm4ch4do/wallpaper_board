---
import ProjectCardItem from "./ProjectCardItem.astro";
import type { ProjectCard } from "../data/projectCards";

interface Props {
    items: ProjectCard[];
}

const { items } = Astro.props;
---

<div class="mt-6 flex gap-6 pr-[20px]">
    {items.map((card) => <ProjectCardItem {...card} />)}
</div>

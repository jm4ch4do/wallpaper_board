---
import type { ProjectCard } from "../data/projectCards";

const {
    iconNumber,
    accent,
    title,
    meta,
    description,
    squares,
    statLabel,
    highlighted = false,
    active = true,
} = Astro.props as ProjectCard;

const effectiveAccent = active ? accent : "gray";
const accentColor =
    effectiveAccent === "purple"
        ? "#c084fc"
        : effectiveAccent === "gray"
          ? "#868D9D"
          : "#22d3ee";
const metaColorClass =
    effectiveAccent === "purple"
        ? "text-purple-400"
        : effectiveAccent === "gray"
          ? "text-slate-500"
          : "text-cyan-400";
const accentLetter =
    effectiveAccent === "purple"
        ? "p"
        : effectiveAccent === "gray"
          ? "gray"
          : "c";
const mapSquareVariant = (variant: string) => {
    if (variant === "") return "";
    if (variant === "e") return `e-${accentLetter}`;
    if (variant === "f") return `f-${accentLetter}`;
    return variant;
};
const borderClass = "border-slate-500/70";
const rowTextClass = highlighted ? "text-cyan-300" : "text-slate-300";
const iconColorClass = highlighted ? "" : "text-slate-400";

// Auto-calculate counter: filled count / total count, or "0 / 0" if inactive
const filledCount = squares.filter((s) => s === "f").length;
const totalCount = squares.length;
const displayLabel = active ? `${filledCount} / ${totalCount}` : "0 / 0";
---

<div
    class:list={[
        "relative",
        "flex-1",
        "rounded-lg",
        "border",
        borderClass,
        "p-5",
        !active && "opacity-50",
    ]}
>
    <div class="flex items-center gap-4">
        <svg viewBox="0 0 100 100" class="size-14 flex-none">
            <polygon
                points="50,4 93,27 93,73 50,96 7,73 7,27"
                fill="none"
                stroke={accentColor}
                stroke-width="4"></polygon>
            <text
                x="50"
                y="64"
                text-anchor="middle"
                font-size="38"
                font-weight="700"
                fill={accentColor}>{iconNumber}</text
            >
        </svg>
        <div>
            <h3
                class="project-title text-white"
            >
                {title}
            </h3>
            <p
                class:list={[
                    "mt-1",
                    "text-xs",
                    "font-semibold",
                    "tracking-widest",
                    metaColorClass,
                ]}
            >
                {meta}
            </p>
        </div>
    </div>
    <p class="mt-4 text-sm text-slate-400">{description}</p>
    <div class="mt-4 flex gap-2" data-project-card-squares>
        {
            squares.map((variant, index) => (
                <span
                    class:list={[
                        "sq",
                        "cursor-pointer",
                        mapSquareVariant(variant),
                    ]}
                    data-square-index={index}
                    data-square-state={
                        variant === ""
                            ? "empty"
                            : variant === "e"
                              ? "empty"
                              : "filled"
                    }
                />
            ))
        }
    </div>
    <div class="my-4 h-px bg-slate-700/70"></div>
    <div
        class:list={["flex", "items-center", "gap-2", "text-sm", rowTextClass]}
        data-project-card-counter
    >
        <svg
            class:list={["size-5", iconColorClass]}
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            viewBox="0 0 24 24"
        >
            <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M16.5 18.75h-9m9 0a3 3 0 0 1 3 3h-15a3 3 0 0 1 3-3m9 0v-3.375c0-.621-.503-1.125-1.125-1.125h-.871M7.5 18.75v-3.375c0-.621.504-1.125 1.125-1.125h.872m5.007 0H9.497m5.007 0a7.454 7.454 0 0 1-.982-3.172M9.497 14.25a7.454 7.454 0 0 0 .981-3.172M5.25 4.236c-.982.143-1.954.317-2.916.52A6.003 6.003 0 0 0 7.73 9.728M5.25 4.236V4.5c0 2.108.966 3.99 2.48 5.228M5.25 4.236V2.721C7.456 2.41 9.71 2.25 12 2.25c2.291 0 4.545.16 6.75.47v1.516M7.73 9.728a6.726 6.726 0 0 0 2.748 1.35m8.272-6.842V4.5c0 2.108-.966 3.99-2.48 5.228m2.48-5.492a46.32 46.32 0 0 1 2.916.52 6.003 6.003 0 0 1-5.395 4.972m0 0a6.726 6.726 0 0 1-2.749 1.35m0 0a6.772 6.772 0 0 1-3.044 0"
            ></path>
        </svg>
        <span class="font-semibold" data-counter-text>{displayLabel}</span>
    </div>
</div>
